# Copy to .env (never commit .env). Restart "npm run dev" after changing it; rebuild before uploading.

# true = offline demo data (try ?id=demo1 and ?id=demo2). Anything else = the live Google Sheet.
VITE_RSVP_USE_MOCK=true

# The Apps Script "Web app URL" (Deploy > Manage deployments). Public by design, not a secret.
VITE_RSVP_SCRIPT_URL=

# The live site address, no slash at the end. Used for the WhatsApp/Facebook preview image,
# which needs a full address. Same value as site_url in the Sheet.
VITE_SITE_URL=https://jm-memorial.malaysia-rsvp.asia
